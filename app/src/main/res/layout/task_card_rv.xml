<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingVertical="@dimen/dp_18"
    android:paddingHorizontal="@dimen/dp_20"
    android:paddingStart="@dimen/dp_20"
    android:background="@drawable/surface_card_bg"
    android:layout_marginVertical="@dimen/dp_10"
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="@dimen/dp_70"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="27"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_22"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JUL"
            android:textAlignment="center"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_14"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/options_btn"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:paddingStart="@dimen/dp_10"
            android:rotation="270"
            android:src="@drawable/options_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/options_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="OS Assignment 3 — Deadlock Handling"
            android:textSize="@dimen/sp_15"
            android:textColor="@color/text"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/subject_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Operating Systems · Reminder: 1 day before"
            android:textColor="@color/text_dim"
            app:layout_constraintTop_toBottomOf="@id/task_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/dp_5"
            android:textSize="@dimen/sp_12"
            />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/subject_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/dp_15"
            app:cardBackgroundColor="@color/accent_dim"

            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:layout_marginVertical="@dimen/dp_5"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:textColor="@color/accent"
                android:textSize="@dimen/sp_10"
                />
        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
