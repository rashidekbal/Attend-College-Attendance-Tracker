<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding_page_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingTop="@dimen/dp_48"
    tools:context=".screens.onBoarding.SubjectInfoOnBoardingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:orientation="horizontal"
        android:weightSum="3"

        >

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_2"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/accent"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_2"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/accent"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/accent"
            app:strokeWidth="0dp"

            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Your Subjects"
            android:textColor="@color/text"

            android:textSize="@dimen/sp_26" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="Add a few now — you can always add or edit them later."
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_5"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_5"
                android:text="Working days per week"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/transparent"
                app:chipSpacingHorizontal="@dimen/dp_10"
                app:selectionRequired="true"
                app:singleSelection="true"

                >

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 days (Mon-fri)"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="@dimen/dp_1"
                    android:checked="true"/>

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipStrokeWidth="1dp"
                    android:text="6 days (Mon-sat)"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border" />


            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_5"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_5"
                android:text="Minimum attendance required"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/transparent"
                app:chipSpacingHorizontal="@dimen/dp_10"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65%"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75%"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp"
                    android:checked="true"/>

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />


            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>


    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="@dimen/dp_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_25"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/dp_24"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/backBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg"
                    android:text="Back"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/dp_24"
                app:strokeWidth="0dp"
                android:layout_marginTop="@dimen/dp_10">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/finish_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Finish setup"
                    android:textColor="@color/all_white"
                    android:background="#95F5A623"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>