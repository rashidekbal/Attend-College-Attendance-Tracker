<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding_page_bg"
    android:fitsSystemWindows="false"
    android:paddingTop="@dimen/dp_48"
    android:paddingHorizontal="@dimen/dp_15"
    android:orientation="vertical"
    tools:context=".screens.onBoarding.WelcomeFragment"
    >

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_45">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:strokeWidth="0dp"
            app:cardCornerRadius="@dimen/dp_24"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:src="@mipmap/ic_launcher"
                />
        </com.google.android.material.card.MaterialCardView>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to"
            android:layout_marginTop="@dimen/dp_20"
            android:textSize="@dimen/sp_28"
            android:textColor="@color/all_black"
            app:fontFamily="inter"
            android:textStyle="bold"

            />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attend"
            android:textColor="@color/accent"
            android:textSize="@dimen/sp_32"
            app:fontFamily="inter"
            android:textStyle="bold"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="@dimen/dp_330"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Your all-in-one college companion for attendance tracking, timetable management, and academic progress — beautifully designed to keep you on top of every semester."
            android:textColor="@color/text_dim"
            android:layout_marginTop="@dimen/dp_15"
            android:lineBreakStyle="normal"
            android:textSize="@dimen/sp_16"
            android:lineHeight="@dimen/dp_22"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="@dimen/dp_10">
        <LinearLayout
            android:id="@+id/action_btn_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/dp_25"
            >
            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/dp_24"
                app:strokeWidth="0dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let's cook"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:background="#95F5A623"
                    android:paddingHorizontal="@dimen/dp_30"
                    android:id="@+id/nextBtn"

                    />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>