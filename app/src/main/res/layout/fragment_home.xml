<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingHorizontal="@dimen/dp_15"
    tools:context=".screens.home.pages.home.HomeFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        >

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sideBar_btn"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_35"
                android:layout_height="@dimen/dp_35"
                android:layout_gravity="center"
                android:padding="@dimen/dp_10"
                android:src="@drawable/side_menu" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/currentDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:text="Wednesday, 29 Jul"
            android:textColor="@color/accent"
            android:textSize="@dimen/sp_20"
            app:layout_constraintStart_toEndOf="@id/sideBar_btn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/profile_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/dp_50"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"

            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RE"
                android:textSize="@dimen/sp_14"
                android:padding="@dimen/dp_15"
                android:textColor="@color/all_white"
                />

        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"

        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="Hey Rasid"
                    android:textColor="@color/text"
                    android:textSize="@dimen/sp_26" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="3 classes today · 1 assignment due tomorrow"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_13" />

            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@drawable/surface_card_bg"
                android:paddingHorizontal="@dimen/dp_15"
                android:paddingVertical="@dimen/dp_20">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:progress="82"
                    app:indicatorColor="@color/accent"
                    app:indicatorSize="@dimen/dp_120"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:trackColor="@color/accent_dim"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="@dimen/dp_12" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/progressIndicator"
                    app:layout_constraintEnd_toEndOf="@id/progressIndicator"
                    app:layout_constraintStart_toStartOf="@id/progressIndicator"
                    app:layout_constraintTop_toTopOf="@id/progressIndicator">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="82%"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_20" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="overall"
                        android:textColor="@color/text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_15"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/progressIndicator"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/progressIndicator"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bunk-safe: 4 classes"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="Threshold set at 75%. Recalculated live as you mark attendance."
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_15" />
                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:layout_weight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:paddingVertical="@dimen/dp_20">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/subjectCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subjects"
                        android:textSize="@dimen/sp_11" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:paddingVertical="@dimen/dp_20">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bunkCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bunked_this_week"

                        android:textSize="@dimen/sp_11" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5"
                    android:layout_weight="1"
                    android:background="@drawable/surface_card_bg"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:paddingVertical="@dimen/dp_20">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/holiday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aug 15"
                        android:textColor="@color/text"
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/next_holiday"
                        android:textSize="@dimen/sp_11" />


                </LinearLayout>

            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Today's Classes"
                    android:textColor="@color/text"
                    android:textFontWeight="600"
                    android:textSize="@dimen/sp_15" />

                <Button
                    android:id="@+id/mark_All_present_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:text="Mark all P"
                    android:textAlignment="textEnd"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_14" />

            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/subject_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:cardBackgroundColor="@color/success"
                    android:layout_marginEnd="@dimen/dp_10"

                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P — Present"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:layout_marginHorizontal="@dimen/dp_15"
                        android:textColor="@color/all_white"
                        android:textSize="@dimen/sp_10"
                        />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/subject_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:cardBackgroundColor="@color/danger"
                    android:layout_marginEnd="@dimen/dp_10"

                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A — Absent"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:layout_marginHorizontal="@dimen/dp_15"
                        android:textColor="@color/all_white"
                        android:textSize="@dimen/sp_10"
                        />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/subject_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:cardBackgroundColor="@color/surface2"
                    android:layout_marginEnd="@dimen/dp_10"

                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="C — Cancel"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:layout_marginHorizontal="@dimen/dp_15"
                        android:textColor="@color/all_white"
                        android:textSize="@dimen/sp_10"
                        />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingTop="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_15"
                    android:background="@drawable/bottom_border"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/dp_15">

                    <LinearLayout
                        android:layout_width="@dimen/dp_170"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/dp_10"
                            android:layout_height="@dimen/dp_10"
                            android:layout_marginStart="@dimen/dp_5"
                            android:layout_marginEnd="@dimen/dp_10"
                            app:cardBackgroundColor="@color/accent"
                            app:cardCornerRadius="@dimen/dp_10" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Data structure"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_18" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="9:00 - 10:00 AM"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_14" />
                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:weightSum="3">
                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/dp_10"
                            >
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/p"
                                android:textColor="@color/text"
                                android:layout_gravity="center"
                                android:textSize="@dimen/sp_16"
                                />
                        </com.google.android.material.card.MaterialCardView>


                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/dp_10"
                            >
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/a"
                                android:textColor="@color/text"
                                android:layout_gravity="center"
                                android:textSize="@dimen/sp_16"
                                />
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border"
                            android:layout_weight="1"

                            >
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/c"
                                android:textColor="@color/text"
                                android:layout_gravity="center"
                                android:textSize="@dimen/sp_16"
                                />
                        </com.google.android.material.card.MaterialCardView>






                    </LinearLayout>


                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_15"
                    android:background="@drawable/bottom_border"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/dp_15">

                    <LinearLayout
                        android:layout_width="@dimen/dp_170"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/dp_10"
                            android:layout_height="@dimen/dp_10"
                            android:layout_marginStart="@dimen/dp_5"
                            android:layout_marginEnd="@dimen/dp_10"
                            app:cardBackgroundColor="@color/success"
                            app:cardCornerRadius="@dimen/dp_10" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Operating system"
                                android:textColor="@color/text"
                                android:textSize="@dimen/sp_18" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="10:00 - 11:00 AM"
                                android:textColor="@color/text_dim"
                                android:textSize="@dimen/sp_14" />
                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:weightSum="3">
                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/dp_10"
                            >
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/p"
                                android:textColor="@color/text"
                                android:layout_gravity="center"
                                android:textSize="@dimen/sp_16"
                                />
                        </com.google.android.material.card.MaterialCardView>


                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/dp_10"
                            >
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/a"
                                android:textColor="@color/text"
                                android:layout_gravity="center"
                                android:textSize="@dimen/sp_16"
                                />
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView

                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/border"
                            android:layout_weight="1"

                            >
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/c"
                                android:textColor="@color/text"
                                android:layout_gravity="center"
                                android:textSize="@dimen/sp_16"
                                />
                        </com.google.android.material.card.MaterialCardView>






                    </LinearLayout>


                </LinearLayout>



            </LinearLayout>
            <LinearLayout
                android:id="@+id/assignment_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="@string/upcoming_assignment"
                        android:textColor="@color/text"
                        android:textFontWeight="600"
                        android:textSize="@dimen/sp_15" />

                    <Button
                        android:id="@+id/navigate_to_tasks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:text="@string/see_all"
                        android:textAlignment="textEnd"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/sp_14" />

                </RelativeLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/dp_18"
                    android:paddingHorizontal="@dimen/dp_20"
                    android:paddingStart="@dimen/dp_20"
                    android:background="@drawable/surface_card_bg"
                    android:layout_marginVertical="@dimen/dp_10"
                    android:orientation="horizontal"
                    >
                    <LinearLayout
                        android:layout_width="@dimen/dp_70"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="27"
                            android:textAlignment="center"
                            android:textColor="@color/text"
                            android:textSize="@dimen/sp_22"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="JUL"
                            android:textAlignment="center"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/sp_14"/>
                    </LinearLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/task_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:text="OS Assignment 3 — Deadlock Handling"
                            android:textSize="@dimen/sp_15"
                            android:textColor="@color/text"
                            />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/subject_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Operating Systems · Reminder: 1 day before"
                            android:textColor="@color/text_dim"
                            app:layout_constraintTop_toBottomOf="@id/task_title"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginTop="@dimen/dp_5"
                            android:textSize="@dimen/sp_12"
                            />
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:strokeWidth="0dp"
                            app:layout_constraintTop_toBottomOf="@id/subject_name"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginTop="@dimen/dp_15"
                            app:cardBackgroundColor="@color/accent_dim"

                            >
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pending"
                                android:layout_marginVertical="@dimen/dp_5"
                                android:layout_marginHorizontal="@dimen/dp_15"
