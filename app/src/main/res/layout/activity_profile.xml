<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_20"
    tools:context=".screens.profile.ProfileActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:padding="@dimen/dp_4"
                android:src="@drawable/arrow_left" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/profile"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_26" />


    </RelativeLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/profile"
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="@dimen/dp_100"
                    android:layout_marginTop="@dimen/dp_25"
                    app:cardBackgroundColor="@color/accent"
                    app:cardCornerRadius="@dimen/dp_50"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="RE"
                        android:textColor="@color/all_white"
                        android:textSize="@dimen/sp_40" />
                </com.google.android.material.card.MaterialCardView>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/accent_pick_slogan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/avatar_color"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintEnd_toEndOf="@id/profile"
                    app:layout_constraintStart_toStartOf="@id/profile"
                    app:layout_constraintTop_toBottomOf="@id/profile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="@id/accent_pick_slogan"
                    app:layout_constraintStart_toStartOf="@id/accent_pick_slogan"
                    app:layout_constraintTop_toBottomOf="@id/accent_pick_slogan">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginEnd="@dimen/dp_10"
                        app:cardBackgroundColor="@color/accent"
                        app:cardCornerRadius="@dimen/dp_50"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginEnd="@dimen/dp_10"
                        app:cardBackgroundColor="@color/success"
                        app:cardCornerRadius="@dimen/dp_50"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginEnd="@dimen/dp_10"
                        app:cardBackgroundColor="@color/danger"
                        app:cardCornerRadius="@dimen/dp_50"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginEnd="@dimen/dp_10"
                        app:cardBackgroundColor="@color/accent"
                        app:cardCornerRadius="@dimen/dp_50"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginEnd="@dimen/dp_10"
                        app:cardBackgroundColor="@color/surface2"
                        app:cardCornerRadius="@dimen/dp_50"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginEnd="@dimen/dp_10"
                        app:cardBackgroundColor="@color/all_white"
                        app:cardCornerRadius="@dimen/dp_50"
                        app:strokeWidth="0dp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_25"
                    android:text="@string/personal_info"
                    android:textAllCaps="true"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/used_across_the_app_for_greetings_and_tracking"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"

                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_15">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="@string/name"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. Jhon doe"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="College / University"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. NIT delhi"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="Department / Branch"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. Btech - cse"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="Roll number"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. 2414342"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="Phone (optional)"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. 9123481954"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="Email (optional)"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. rashid@college.edu"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_25"
                    android:text="Academic"
                    android:textAllCaps="true"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Controls how attendance % is calculated"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"

                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_15">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:text="Current semester"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@android:color/transparent"
                    app:chipSpacingHorizontal="@dimen/dp_10"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sem1"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="1st"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/sem2"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2nd"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3rd"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4th"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5th"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6th"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7th"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8th"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />


                </com.google.android.material.chip.ChipGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Year of study"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@android:color/transparent"
                    app:chipSpacingHorizontal="@dimen/dp_10"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1st"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2nd"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3rd"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4th"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Working days per week"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@android:color/transparent"
                    app:chipSpacingHorizontal="@dimen/dp_10"
                    app:selectionRequired="true"
                    app:singleSelection="true"

                    >

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 days (Mon-fri)"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="@dimen/dp_1" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipStrokeWidth="1dp"
                        android:text="6 days (Mon-sat)"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border" />


                </com.google.android.material.chip.ChipGroup>

                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="First class start time"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"

                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginVertical="@dimen/dp_5"
                    android:background="@drawable/surface2_card_background"
                    android:hint="9:00 AM"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:textColor="@color/text"
                    android:inputType="time"
                    android:textColorHint="@color/text_faint"
                    android:textSize="@dimen/sp_14" />
                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Semester start date"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"

                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginVertical="@dimen/dp_5"
                    android:background="@drawable/surface2_card_background"
                    android:hint="@string/dd_mm_yyyy"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:textColor="@color/text"
                    android:inputType="date"
                    android:textColorHint="@color/text_faint"
                    android:textSize="@dimen/sp_14" />
                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Semester end date"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"

                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginVertical="@dimen/dp_5"
                    android:background="@drawable/surface2_card_background"
                    android:hint="@string/dd_mm_yyyy"
                    android:paddingHorizontal="@dimen/dp_15"
