<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding_page_bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingTop="@dimen/dp_48"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:orientation="horizontal"
        android:weightSum="3"

        >

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_2"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/accent"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_2"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"

            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tell us about you"
            android:textColor="@color/text"

            android:textSize="@dimen/sp_26" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="We'll personalize your dashboard and semester tracking."
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_5"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_5"
                android:text="Name"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"

                />

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginVertical="@dimen/dp_5"
                android:background="@drawable/surface2_card_background"
                android:hint="e.g. Rashid ekbal"
                android:paddingHorizontal="@dimen/dp_15"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="@dimen/sp_14" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_5"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_5"
                android:text="College name (Optional)"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"

                />

            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginVertical="@dimen/dp_5"
                android:background="@drawable/surface2_card_background"
                android:hint="e.g. IIT dholakpur"
                android:paddingHorizontal="@dimen/dp_15"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="@dimen/sp_14" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:layout_marginBottom="@dimen/dp_10"
                android:text="Current semester"
                android:textAllCaps="true"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/transparent"
                app:chipSpacingHorizontal="@dimen/dp_10"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/sem1"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="1st"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/sem2"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2nd"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3rd"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4th"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5th"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6th"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7th"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8th"
                    android:textColor="@color/text"
                    app:chipBackgroundColor="@color/chip_color_list"
                    app:chipCornerRadius="@dimen/dp_16"
                    app:chipStrokeColor="@color/border"
                    app:chipStrokeWidth="1dp" />


            </com.google.android.material.chip.ChipGroup>


        </LinearLayout>
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="@dimen/dp_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp_25"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/dp_24"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/backBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg"
                    android:text="Back"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/dp_24"
                app:strokeWidth="0dp"
                android:layout_marginTop="@dimen/dp_10">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/continue_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Continue"
                    android:textColor="@color/all_white"
                    android:background="#95F5A623"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>