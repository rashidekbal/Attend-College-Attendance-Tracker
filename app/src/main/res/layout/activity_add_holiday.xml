<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_20"
    tools:context=".screens.holiday.AddHolidayActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:padding="@dimen/dp_4"
                android:src="@drawable/arrow_left" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Add Holiday"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_26" />


    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:text="Excluded automatically from attendance %."
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_14"

            />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            android:text="Holiday name"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"

            />

        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginVertical="@dimen/dp_5"
            android:background="@drawable/surface2_card_background"
            android:hint="eg. Diwali"
            android:paddingHorizontal="@dimen/dp_15"
            android:textColor="@color/text"
            android:textColorHint="@color/text_faint"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:text="Start date"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"

            />

        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginVertical="@dimen/dp_5"
            android:background="@drawable/surface2_card_background"
            android:hint="@string/dd_mm_yyyy"
            android:inputType="date"
            android:paddingHorizontal="@dimen/dp_15"
            android:textColor="@color/text"
            android:textColorHint="@color/text_faint"
            android:textSize="@dimen/sp_14" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_10"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:text="End date"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"

            />

        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginVertical="@dimen/dp_5"
            android:background="@drawable/surface2_card_background"
            android:hint="@string/dd_mm_yyyy"
            android:inputType="date"
            android:paddingHorizontal="@dimen/dp_15"
            android:textColor="@color/text"
            android:textColorHint="@color/text_faint"
            android:textSize="@dimen/sp_14" />


    </LinearLayout>


    <androidx.appcompat.widget.AppCompatTextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:text="Remind me"
        android:textAllCaps="true"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"

        />

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/transparent"
        app:chipSpacingHorizontal="@dimen/dp_10"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On due day"
            android:textColor="@color/text"
            app:chipBackgroundColor="@color/chip_color_list"
            app:chipCornerRadius="@dimen/dp_16"
            app:chipStrokeColor="@color/border"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 day before"
            android:textColor="@color/text"
            app:chipBackgroundColor="@color/chip_color_list"
            app:chipCornerRadius="@dimen/dp_16"
            app:chipStrokeColor="@color/border"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 days before"
            android:textColor="@color/text"
            app:chipBackgroundColor="@color/chip_color_list"
            app:chipCornerRadius="@dimen/dp_16"
            app:chipStrokeColor="@color/border"
            app:chipStrokeWidth="1dp" />


    </com.google.android.material.chip.ChipGroup>


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_15"
        app:cardBackgroundColor="@android:color/transparent">

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/accent"
            android:paddingVertical="@dimen/dp_5"
            android:text="Save Holiday"
            android:textAllCaps="false"
            android:textColor="@color/all_white" />
    </com.google.android.material.card.MaterialCardView>


</LinearLayout>
