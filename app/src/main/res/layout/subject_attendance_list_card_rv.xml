<LinearLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="@dimen/dp_15"
    android:background="@drawable/bottom_border"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/dp_15"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="@dimen/dp_250"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_10"
            app:cardBackgroundColor="@color/accent"
            app:cardCornerRadius="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_5"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/ssubjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data structure"
                android:textColor="@color/text"
                android:textSize="@dimen/sp_18"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/class_attended"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="38 / 42 classes"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/sp_14"
                />
        </LinearLayout>



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="end"
        >
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/attendance_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80%"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/sp_15"
            android:textColor="@color/success"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:src="@drawable/greater_than"
            android:rotation="180"
            android:layout_gravity="center_vertical"
            android:padding="@dimen/dp_6"
            />


    </LinearLayout>


</LinearLayout>