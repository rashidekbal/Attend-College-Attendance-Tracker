<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingBottom="@dimen/dp_20"
    tools:context=".screens.subject.AddSubjectActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_42"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:padding="@dimen/dp_4"
                android:src="@drawable/arrow_left" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Add subject"
            android:textAlignment="center"
            android:textColor="@color/text"
            android:textSize="@dimen/sp_26" />


    </RelativeLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="One entry, tracked everywhere — attendance, marks, assignments."
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/surface_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dp_12"
                android:paddingVertical="@dimen/dp_15">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="Subject name"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. Operating system"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_10"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:text="Classes per week"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"

                        />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_50"
                        android:layout_marginVertical="@dimen/dp_5"
                        android:background="@drawable/surface2_card_background"
                        android:hint="eg. 4"
                        android:paddingHorizontal="@dimen/dp_15"
                        android:textColor="@color/text"
                        android:inputType="number"
                        android:textColorHint="@color/text_faint"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Attandance threashold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@android:color/transparent"
                    app:chipSpacingHorizontal="@dimen/dp_10"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="65%"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="75%"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80%"
                        android:textColor="@color/text"
                        app:chipBackgroundColor="@color/chip_color_list"
                        app:chipCornerRadius="@dimen/dp_16"
                        app:chipStrokeColor="@color/border"
                        app:chipStrokeWidth="1dp" />


                </com.google.android.material.chip.ChipGroup>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="Color tag"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/dp_5"
                    >
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        app:cardBackgroundColor="@color/accent"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="@dimen/dp_50"
                        android:layout_marginEnd="@dimen/dp_10"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        app:cardBackgroundColor="@color/success"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="@dimen/dp_50"
                        android:layout_marginEnd="@dimen/dp_10"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        app:cardBackgroundColor="@color/danger"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="@dimen/dp_50"
                        android:layout_marginEnd="@dimen/dp_10"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        app:cardBackgroundColor="@color/accent"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="@dimen/dp_50"
                        android:layout_marginEnd="@dimen/dp_10"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        app:cardBackgroundColor="@color/surface2"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="@dimen/dp_50"
                        android:layout_marginEnd="@dimen/dp_10"/>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_40"
                        android:layout_height="@dimen/dp_40"
                        app:cardBackgroundColor="@color/all_white"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="@dimen/dp_50"
                        android:layout_marginEnd="@dimen/dp_10"/>

                </LinearLayout>



            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/dp_15"
                app:cardBackgroundColor="@android:color/transparent">
                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save Subject"
                    android:textAllCaps="false"
                    android:textColor="@color/all_white"

                    android:background="@color/accent"/>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
